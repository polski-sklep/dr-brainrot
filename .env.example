# --- Spotify ---------------------------------------------------------------
# https://developer.spotify.com/dashboard  -> Create app
# Redirect URI to register EXACTLY: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written by auth_spotify.py after the one-time browser consent
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Telegram --------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric user ID of the single authorised user; everything else is ignored
TELEGRAM_BOT_USERNAME=pendulumofpodcasts_bot
TELEGRAM_USER_ID=

# --- Config ----------------------------------------------------------------
WEEKLY_ALLOWANCE_MIN=360
# POP's own timezone, deliberately not the POSIX `TZ`: an ambient TZ=UTC from
# a cron or systemd environment must never move the triage boundary.
POP_TZ=Europe/Warsaw
LOCK_HOURS=48
LIFESPAN_CYCLES=2

# --- Paths -----------------------------------------------------------------
POP_DB_PATH=data/pop.db

# --- YouTube ---------------------------------------------------------------
# console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials ->
# API key, restricted to that API. Used only for videos.list (durations).
YOUTUBE_API_KEY=

# --- DRBR ------------------------------------------------------------------
# Absolute path to the Obsidian vault. Never committed.
DRBR_VAULT_PATH=
# Top-level folder whose contents count as unprocessed.
DRBR_VAULT_INBOX=01-Inbox
# JSONL outbox obsidian-ingest appends one line to per capture.
DRBR_CAPTURE_OUTBOX=data/vault_captures.jsonl
# Raw evidence (screenshots, exports, history payloads), kept for re-parsing.
DRBR_RAW_DIR=data/raw
DRBR_DIAGNOSTIC_WEEKS=8
# Dashboard + extension ingest endpoint, bound to 127.0.0.1 only.
DRBR_DASHBOARD_PORT=8750
# Shared secret the browser extension sends. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
DRBR_INGEST_TOKEN=
# First local date (a Sunday) that counts as diagnostic data; earlier history is kept as evidence only.
DRBR_GO_LIVE=
# Cold Turkey's local statistics database. When set, the daily job reads it (hostnames and minutes only)
# and no weekly export is needed. Leave empty to rely on manual exports sent to the bot.
DRBR_COLDTURKEY_DB=/Library/Application Support/Cold Turkey/data-browser.db
# Qbserve's database, for desktop app time (DECISIONS DR5.3). When set, the daily job reads per-app minutes
# per day (never window titles, never Qbserve's productivity ratings) and skips browsers, which Cold Turkey
# measures. Keep Qbserve open at login. Leave empty to leave desktop apps unmeasured.
DRBR_QBSERVE_DB=~/Library/Application Support/Qbserve/UserDatabase.sqlite
# Optional (DECISIONS DR5.28). Where the Audible sign-in is, saved by `.venv/bin/python audible_login.py`
# (run it yourself). Defaults to data/audible_auth.json; if the file isn't there, audiobooks aren't measured.
# DRBR_AUDIBLE_AUTH=data/audible_auth.json

# --- Anthropic (optional) --------------------------------------------------
# Used only for the Overview's weekly written summary (DECISIONS DR5.8). One
# Claude Opus 5 call a week, sent aggregate figures only — never a source name,
# an item title, a note title or a path. Leave it empty (or delete the key) and
# the panel shows DRBR's own computed sentences instead.
ANTHROPIC_API_KEY=
