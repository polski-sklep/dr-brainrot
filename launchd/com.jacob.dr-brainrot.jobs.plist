<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dr-brainrot daily jobs — `jobs.py daily`: read the capture outbox, scan the vault,
  read Cold Turkey and Qbserve, then on Sundays send the check-in for the week
  just finished (and on Monday its one reminder, if evidence is still
  missing), and the diagnostic-end notice. See checklist.py (DR5.24).

  TIMEZONE. launchd's StartCalendarInterval fires in SYSTEM local time
  (Europe/Warsaw), which matches DR_BRAINROT_TZ. 09:30 is after the 09:17 poll, so
  the two do not run at once, and off the hour to avoid piling onto :00.

  Unlike cron, launchd runs a MISSED calendar job at the next wake. Each step
  is isolated, and every read comes before any send, so Telegram being
  unreachable fails only the sending steps (DR5.25). Any failed step makes the
  run exit 1 (see logs/jobs.log).

  Install:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jacob.dr-brainrot.jobs.plist
  Run now:  launchctl kickstart -p gui/$(id -u)/com.jacob.dr-brainrot.jobs
  Stop:     launchctl bootout   gui/$(id -u)/com.jacob.dr-brainrot.jobs
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jacob.dr-brainrot.jobs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Jacob/Projects/dr-brainrot/.venv/bin/python</string>
        <string>/Users/Jacob/Projects/dr-brainrot/jobs.py</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Jacob/Projects/dr-brainrot</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Jacob/Projects/dr-brainrot/logs/jobs.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Jacob/Projects/dr-brainrot/logs/jobs.log</string>
</dict>
</plist>
