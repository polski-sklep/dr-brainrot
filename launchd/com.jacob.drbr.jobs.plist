<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DRBR daily jobs — `jobs.py daily`: read the capture outbox, scan the vault,
  send due import prompts and label batches, and the diagnostic-end notice.

  TIMEZONE. launchd's StartCalendarInterval fires in SYSTEM local time
  (Europe/Warsaw), which matches POP_TZ. 09:30 is after POP's 09:17 poll, so
  the two do not run at once, and off the hour to avoid piling onto :00.

  Unlike cron, launchd runs a MISSED calendar job at the next wake. Each step
  is isolated; any failed step makes the run exit 1 (see logs/jobs.log).

  Install:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jacob.drbr.jobs.plist
  Run now:  launchctl kickstart -p gui/$(id -u)/com.jacob.drbr.jobs
  Stop:     launchctl bootout   gui/$(id -u)/com.jacob.drbr.jobs
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jacob.drbr.jobs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Jacob/Projects/drbr/.venv/bin/python</string>
        <string>/Users/Jacob/Projects/drbr/jobs.py</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Jacob/Projects/drbr</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Jacob/Projects/drbr/logs/jobs.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Jacob/Projects/drbr/logs/jobs.log</string>
</dict>
</plist>
